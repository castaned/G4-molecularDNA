# Ejecutar con la geometría y el visor ya abiertos. No lanza eventos.
# Contenedores exteriores ocultos; segmento en alambre y moléculas visibles.
/vis/viewer/set/autoRefresh false
/vis/geometry/set/visibility world 0 false
/vis/geometry/set/visibility CellLogical 0 false
/vis/geometry/set/visibility DNAPhysLV 0 false
/vis/geometry/set/visibility straight 0 true
/vis/viewer/set/background black
/vis/viewer/set/style wireframe
/vis/viewer/set/viewpointThetaPhi 60 120
/vis/viewer/panTo 0 0 nm
/vis/viewer/zoomTo 10
/vis/viewer/set/autoRefresh true
/vis/viewer/rebuild
/vis/viewer/flush
