# Vista inicial: geometría sin eventos. Basada en Geant4 v11.3.0 vis.mac.
# DNAWorld es el mundo paralelo registrado en la copia de visualización.
/vis/open OGL
/vis/viewer/set/autoRefresh false
/vis/verbose warnings
/vis/drawVolume DNAWorld
/vis/viewer/set/viewpointThetaPhi 90 180
/vis/viewer/set/style surface
/vis/viewer/zoomTo 1
/vis/viewer/set/autoRefresh true
/vis/viewer/flush
